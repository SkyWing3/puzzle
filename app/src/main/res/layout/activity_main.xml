<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/decorTopSparkle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0.2"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="12"
        android:src="@drawable/ic_sparkle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="-16dp"
        android:layout_marginTop="-12dp" />

    <ImageView
        android:id="@+id/decorBottomPaw"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:alpha="0.18"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="-18"
        android:src="@drawable/ic_paw"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="-24dp"
        android:layout_marginBottom="-16dp" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/bg_toolbar"
        android:elevation="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/toolbar_title"
        app:titleCentered="true"
        app:titleTextColor="@color/on_toolbar" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlPanelCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_instruction_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/board_inner_padding"
            android:paddingTop="@dimen/spacing_large"
            android:paddingEnd="@dimen/board_inner_padding"
            android:paddingBottom="@dimen/spacing_large">

            <TextView
                style="@style/Widget.Puzzle.StatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/controls_title" />

            <LinearLayout
                android:id="@+id/bottomActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shuffleButton"
                    style="@style/Widget.Puzzle.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:layout_weight="1"
                    android:text="@string/shuffle"
                    app:icon="@drawable/ic_shuffle"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/spacing_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/autoSolveButton"
                    style="@style/Widget.Puzzle.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auto_solve" />

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_large"
                app:dividerColor="@color/decor_paw_light"
                app:dividerInsetStart="0dp"
                app:dividerInsetEnd="0dp" />

            <LinearLayout
                android:id="@+id/imageActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pickImageButton"
                    style="@style/Widget.Puzzle.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:layout_weight="1"
                    android:text="@string/pick_image" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/captureImageButton"
                    style="@style/Widget.Puzzle.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/capture_image" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_extra_large"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/controlPanelCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_extra_large"
            android:paddingEnd="@dimen/screen_margin">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_extra_large"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_instruction_card"
                    android:paddingStart="@dimen/board_inner_padding"
                    android:paddingTop="@dimen/spacing_large"
                    android:paddingEnd="@dimen/board_inner_padding"
                    android:paddingBottom="@dimen/spacing_large">

                    <LinearLayout
                        android:id="@+id/heroContent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/heroIllustration"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="@dimen/spacing_large">

                        <TextView
                            android:id="@+id/instructionsText"
                            style="@style/Widget.Puzzle.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/puzzle_instructions"
                            android:textAlignment="viewStart" />

                        <TextView
                            android:id="@+id/heroTagline"
                            style="@style/Widget.Puzzle.Tagline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:background="@null"
                            android:gravity="start"
                            android:text="@string/main_tagline"
                            android:textAlignment="viewStart" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/heroIllustration"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_cat_face"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/puzzleFlow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="boardCard,statusPanel"
                    app:flow_horizontalGap="@dimen/spacing_large"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalAlign="top"
                    app:flow_verticalGap="@dimen/spacing_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/boardCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_board_card"
                        android:paddingBottom="@dimen/spacing_large">

                        <ImageView
                            android:id="@+id/boardBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|top"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sparkle" />

                        <GridLayout
                            android:id="@+id/puzzleGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:alignmentMode="alignMargins"
                            android:columnCount="3"
                            android:padding="@dimen/board_inner_padding"
                            android:rowCount="3"
                            android:useDefaultMargins="false"
                            tools:itemCount="9"
                            tools:listitem="@layout/view_tile" />

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statusPanel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_message"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/board_inner_padding"
                        android:paddingTop="@dimen/spacing_large"
                        android:paddingEnd="@dimen/board_inner_padding"
                        android:paddingBottom="@dimen/spacing_large">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cat_face" />

                            <TextView
                                style="@style/Widget.Puzzle.StatLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:layout_weight="1"
                                android:text="@string/label_status" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_large"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_paw" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/timeCounter"
                                    style="@style/Widget.Puzzle.StatValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/time_counter_placeholder" />

                                <TextView
                                    style="@style/Widget.Puzzle.StatLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_small"
                                    android:text="@string/label_time" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_large"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sparkle" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/moveCounter"
                                    style="@style/Widget.Puzzle.StatValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/move_counter_placeholder" />

                                <TextView
                                    style="@style/Widget.Puzzle.StatLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_small"
                                    android:text="@string/label_moves" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusMessage"
                            style="@style/Widget.Puzzle.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_large"
                            android:text="@string/status_ready_level"
                            android:textAlignment="viewStart"
                            android:textColor="@color/status_message_text" />

                        <TextView
                            android:id="@+id/levelIndicator"
                            style="@style/Widget.Puzzle.LevelPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_large"
                            android:text="@string/level_indicator_placeholder" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/referenceCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_large"
                            android:visibility="gone"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_reference_preview"
                                android:orientation="vertical"
                                android:padding="@dimen/board_inner_padding">

                                <TextView
                                    style="@style/Widget.Puzzle.StatLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_reference" />

                                <ImageView
                                    android:id="@+id/referenceImage"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_medium"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@string/reference_image_description"
                                    android:scaleType="centerCrop"
                                    tools:src="@drawable/bg_tile" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
