<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_primary_disabled" />
            <corners android:radius="@dimen/button_corner_radius_large" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="@color/button_primary_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/button_primary_pressed_end"
                android:startColor="@color/button_primary_pressed_start" />
            <corners android:radius="@dimen/button_corner_radius_large" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="@color/button_primary_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/button_primary_end"
                android:startColor="@color/button_primary_start" />
            <corners android:radius="@dimen/button_corner_radius_large" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="@color/button_primary_stroke" />
        </shape>
    </item>
</selector>
