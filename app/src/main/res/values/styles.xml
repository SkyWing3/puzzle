<resources>
    <style name="Tile">
        <item name="android:layout_width">@dimen/tile_size</item>
        <item name="android:layout_height">@dimen/tile_size</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:textSize">@dimen/tile_text_size</item>
        <item name="android:textColor">@color/tile_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_margin">@dimen/tile_spacing</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:importantForAccessibility">yes</item>
    </style>

    <style name="Widget.Puzzle.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/body_text</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Puzzle.Counter" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/counter_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Puzzle.Status" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/status_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.Puzzle.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/status_text</item>
        <item name="android:alpha">0.85</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.Puzzle.Tagline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/status_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="Widget.Puzzle.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="iconTint">@color/button_primary_text</item>
        <item name="rippleColor">@color/button_ripple</item>
    </style>

    <style name="Widget.Puzzle.SecondaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="iconTint">@color/button_secondary_text</item>
        <item name="rippleColor">@color/button_ripple</item>
    </style>

    <style name="Widget.Puzzle.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/on_toolbar</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Puzzle.LevelPill" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/button_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/bg_level_indicator</item>
        <item name="android:paddingStart">@dimen/chip_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/chip_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/chip_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/chip_padding_vertical</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="Widget.Puzzle.StatValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/on_toolbar</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Puzzle.StatLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/status_text</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
