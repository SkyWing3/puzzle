<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_secondary_disabled_fill" />
            <corners android:radius="@dimen/button_corner_radius_large" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="@color/button_secondary_disabled_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_secondary_pressed_fill" />
            <corners android:radius="@dimen/button_corner_radius_large" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="@color/button_secondary_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_secondary_fill" />
            <corners android:radius="@dimen/button_corner_radius_large" />
            <stroke
                android:width="@dimen/button_stroke_width"
                android:color="@color/button_secondary_stroke" />
        </shape>
    </item>
</selector>
