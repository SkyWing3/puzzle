<resources>
    <style name="Tile">
        <item name="android:layout_width">@dimen/tile_size</item>
        <item name="android:layout_height">@dimen/tile_size</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:textSize">@dimen/tile_text_size</item>
        <item name="android:textColor">@color/tile_text</item>
        <item name="android:layout_margin">@dimen/tile_spacing</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:importantForAccessibility">yes</item>
    </style>

    <style name="Widget.Puzzle.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/body_text</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Puzzle.Counter" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/counter_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Puzzle.Status" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/status_text</item>
    </style>

    <style name="Widget.Puzzle.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="backgroundTint">@color/button_background</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="iconTint">@color/button_text</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="Widget.Puzzle.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
    </style>
</resources>
